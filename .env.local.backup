POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=music_db
POSTGRES_PORT=5432


LOG_LEVEL=log
LOG_MAX_FILE_SIZE_KB=64
# LOG_FILE_PATH=logs/app.log          # можно не задавать — будут дефолты
# LOG_ERROR_FILE_PATH=logs/error.log  # можно не задавать
APP_PORT=4000


DATABASE_URL="postgresql://postgres:postgres@localhost:5433/music_db?schema=public"


DATABASE_URL_DOCKER="postgresql://postgres:postgres@postgres:5432/music_db?schema=public"

JWT_ACCESS_SECRET=access_secret_123
JWT_REFRESH_SECRET=refresh_secret_456
JWT_ACCESS_EXPIRES_IN=60s
JWT_REFRESH_EXPIRES_IN=7d
